# ============================================================
#  fnmusic_kugou_pro — 不入库清单
# ============================================================

# ---- 构建产物 / 打包输出 ----
out/
*.fpk
app.tgz
build/
dist/

# ---- Python 字节码 ----
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.venv-proxy/

# ---- 必须由安装脚本生成、绝不能进包的运行时配置 ----
# 原因：飞牛覆盖安装是「先解包覆盖安装目录，再跑 upgrade_callback」。
# 包里若自带 .env，它会在回调有机会迁移之前就把用户真配置（含登录令牌）盖掉。
# 详见 README 的"持久化目录"一节。
.env
.env.*
!.env.example

# ---- 本地开发日志 / 临时文件 ----
*.log
*.pid
*.sock
*.bak
*.orig
*.rej
*.tmp
*.swp

# ---- 内部资料：含本机环境细节与安全分析，不对外 ----
docs-internal/

# ---- 本机交付说明（含本机部署事实：端口、被占用情况等）----
/说明.md

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
