# fnmusic-pro cmd/uninstall_init
# 卸载前：只清理代理自己的 socket，不碰飞牛音乐的 socket

TARGET_SOCK="/var/run/trim_music.socket"
UPSTREAM_SOCK="/var/run/trim_music_upstream.socket"

# 停本扩展进程
# P-01：PID 文件可能已被清掉（旧版把它放 /tmp），这里按 /proc cmdline
# 兜底认领，避免卸载后留下孤儿进程继续占着 socket。
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if . "${SCRIPT_DIR}/_proxy_state.sh" 2>/dev/null; then
    STATE_DIR="$(fnmusic_state_dir)"
    APP_DIR="$(fnmusic_app_dir "$STATE_DIR" || true)"
    if [ -n "$APP_DIR" ]; then
        APP_DIR_REAL="$(readlink -f "$APP_DIR" 2>/dev/null || printf '%s' "$APP_DIR")"
        fnmusic_kill_all "$APP_DIR_REAL" \
            "${STATE_DIR}/${FNMUSIC_STATE_PID_NAME}" \
            "/tmp/${FNMUSIC_STATE_PID_NAME}"
    else
        rm -f "${STATE_DIR}/${FNMUSIC_STATE_PID_NAME}" "/tmp/${FNMUSIC_STATE_PID_NAME}"
    fi
else
    # 共享脚本缺失（包不完整）时退回到旧行为，别让卸载流程直接卡死
    PID_FILE="/tmp/fnmusic-pro.pid"
    if [ -f "$PID_FILE" ]; then
        pid="$(cat "$PID_FILE" 2>/dev/null || true)"
        if [ -n "$pid" ]; then
            kill "$pid" 2>/dev/null || true
            sleep 2
            kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
        fi
        rm -f "$PID_FILE"
    fi
fi

# 检查 TARGET 是否是代理占的 socket（通过 healthz 判断）
is_proxy_socket() {
    local h
    h="$(curl -s --max-time 2 --unix-socket "$TARGET_SOCK" http://localhost/_ext/healthz 2>/dev/null || true)"
    echo "$h" | grep -q '"upstream"'
}

# 只有 TARGET 是代理的 socket 时才删
if [ -S "$TARGET_SOCK" ]; then
    if is_proxy_socket; then
        rm -f "$TARGET_SOCK" 2>/dev/null || true
    fi
fi

# 如果 upstream socket 还在，还原到 TARGET（覆盖情况）
if [ -S "$UPSTREAM_SOCK" ]; then
    rm -f "$TARGET_SOCK" 2>/dev/null || true
    mv "$UPSTREAM_SOCK" "$TARGET_SOCK" 2>/dev/null || true
    chmod 666 "$TARGET_SOCK" 2>/dev/null || true
fi

exit 0
