# fnmusic-pro cmd/install_callback
# 每步都写日志，便于诊断

LOGF="$TRIM_TEMP_LOGFILE"
if [ -z "$LOGF" ]; then
    LOGF="/tmp/fnmusic-pro-install.log"
fi
mkdir -p "$(dirname "$LOGF")" 2>/dev/null || true

# 日志双写：$LOGF + stderr。
#   stderr 会被飞牛应用中心捕获、显示在安装输出里 —— 用户点「安装」时
#   **当场看得见**。只写 $LOGF 的话，用户永远不知道"我在配置页改了，为什么没生效"。
# ⚠ 绝不能写 stdout：_env_take / env_scalar / env_flag 的返回值**就是 stdout**
#   （调用方写的是 KUGOU_URL="$(env_scalar ...)"），往 stdout 打日志会把配置值
#   污染成「提示语 + 真值」。所以这里固定走 >&2。
note() {
    echo "[install_callback] $*" >> "$LOGF" 2>/dev/null
    echo "[install_callback] $*" >&2
}

echo "[install_callback] START whoami=$(id -un) @ $(date)" >> "$LOGF"

APPDEST="$TRIM_APPDEST"
if [ -z "$APPDEST" ] || [ ! -d "$APPDEST" ]; then
    echo "[install_callback] FAIL: APPDEST 空/不存在" >> "$LOGF"
    exit 1
fi

echo "[install_callback] APPDEST=$APPDEST" >> "$LOGF"

# ===== 音乐接口占用检测（1.0.0 新增，早失败、不留半成品）=====
# 本应用接管 /var/run/trim_music.socket。若该 socket 已被**另一个音源扩展**
# （典型：上游 fnmusic_ext_kugou）占用，两版将无法共存 —— 两者的 uninstall
# 脚本都会"见 TARGET 是代理就删掉它并搬回真音乐"，卸载任一方都会静默拆掉
# 另一方。旧版代码改不了，只能靠"装之前先确认没人占着"来防。
#
# 判据用 live socket 而非目录是否存在：@appconf 里有 22 个已卸载应用的残留
# 目录，用目录判断会"自锁、永远装不上"。
#
# 安装阶段这里只做**告警**、不阻断（阻断交由 cmd/main start 执行）：
# 飞牛的 install_callback 若直接 exit 1，用户看到的只是一个失败提示，
# 而真正常见的场景是"用户已卸载旧版但旧版进程/socket 还没退干净"，
# 此时硬失败会让用户反复重装却不明白原因。启动时再判定更准确、
# 且那才是真正会造成"两版共存"的时刻。若确实被占用，启动会明确拒绝。
TARGET_SOCK="/var/run/trim_music.socket"
if [ -S "$TARGET_SOCK" ]; then
    # 谁在持有这个 socket？—— 只看事实，不猜。
    #
    # 旧实现两处硬伤，都属于"看着能跑"的类型：
    #   1) `ss ... | head -1` 只取一个 pid，等于抽盲盒。真机上 uvicorn 与
    #      app_socket_bridge 会同时持有（fork 共享 fd），一个 socket 也可能挂
    #      多条记录 —— 取一条既可能漏掉真正的占用者，也可能抓到无关进程。
    #   2) 靠"能不能从 healthz 嗅到 upstream 字段"判断是不是扩展。于是
    #      **重装自己必然误报**（我们的 healthz 正好有这个字段），而真被别的
    #      扩展占用时反而可能漏报（对方没实现 healthz 就嗅不到）。
    #
    # 现在：把**所有**持有者的 pid 全取出来，逐个看 /proc/<pid>/exe 与 cwd，
    # 按"可执行文件在哪个应用目录下"分类。用 exe 而不是整条 cmdline，是因为
    # 接管同一个 socket 的扩展，命令行里**必然**带着 /var/run/trim_music.socket
    # 这个路径 —— 拿 cmdline 判断会把它们全认成飞牛音乐本体。
    # 这里踩过一个坑，记下来：不能加 `tail -n +2` 去"跳过表头" ——
    # `ss -x` 输出**本来就没有表头**（`ss -t` 才有），tail 会把唯一那一行
    # 直接删掉，于是 _pids 永远为空、占用检测静默失效（看着一切正常，
    # 其实什么都没查）。用 grep -F 过滤 socket 路径就够了。
    _pids="$(ss -xlp 2>/dev/null | grep -F "$TARGET_SOCK" \
        | grep -o 'pid=[0-9]*' | cut -d= -f2 | sort -u)"
    if [ -z "$_pids" ]; then
        echo "[install_callback] INFO: socket 存在但读不到持有进程（权限不足或 ss 格式变动），跳过占用检测" >> "$LOGF"
    else
        _self_pids=""
        _music_pids=""
        _other_desc=""
        for _p in $_pids; do
            _exe="$(readlink -f "/proc/$_p/exe" 2>/dev/null || true)"
            _cwd="$(readlink -f "/proc/$_p/cwd" 2>/dev/null || true)"
            _sig="$_exe $_cwd"
            if [ -z "$_exe" ]; then
                # 读不到 exe（非 root / 进程刚退）：退回 cmdline，但先把 socket
                # 路径本身剔掉，否则"其他扩展"会被 socket 路径带偏成音乐本体。
                _cmd="$(tr '\0' ' ' < "/proc/$_p/cmdline" 2>/dev/null)"
                _sig="$(printf '%s' "$_cmd" | sed "s|$TARGET_SOCK||g")"
            fi
            case "$_sig" in
                *fnmusic_kugou_pro*) _self_pids="$_self_pids $_p" ;;
                *trim.music*|*trim-music*) _music_pids="$_music_pids $_p" ;;
                *) _other_desc="$_other_desc [pid=$_p $(printf '%s' "$_sig" | cut -c1-160)]" ;;
            esac
        done
        # 补 || true：`[ -n ] && echo` 在条件为假时整体返回 1。本脚本没有
        # set -e，所以现在无害；但哪天有人加了 set -e，这行会让安装在写 .env
        # **之前**静默退出。安装脚本最不该有的就是"看起来跑完了"。
        [ -n "$_self_pids" ] && echo "[install_callback] INFO: 目标 socket 由本应用自己持有（pid$_self_pids），按覆盖安装处理（正常）" >> "$LOGF" || true
        [ -n "$_music_pids" ] && echo "[install_callback] INFO: 目标 socket 由飞牛音乐本体持有（pid$_music_pids），正常" >> "$LOGF" || true
        if [ -n "$_other_desc" ]; then
            echo "[install_callback] WARN: 音乐接口已被其他音源扩展占用 ->$_other_desc" >> "$LOGF"
            echo "[install_callback] WARN: 请先到【应用中心】停用并卸载旧扩展 fnmusic_ext_kugou，" >> "$LOGF"
            echo "[install_callback] WARN: 否则本应用启动时会被拒绝（详见 说明.md）。" >> "$LOGF"
        fi
    fi
fi

# 官方契约：Python 3.12 依赖路径
export PATH="/var/apps/python312/target/bin:/var/apps/python312/bin:/vol1/@appcenter/python312/bin:$PATH"

# 找 Python 3.12
PY312=""
for CAND in python3.12 python3 python; do
    if command -v "$CAND" >/dev/null 2>&1; then
        V=$("$CAND" --version 2>/dev/null)
        case "$V" in
            *3.12*) PY312="$CAND" ;;
        esac
    fi
    if [ -n "$PY312" ]; then break; fi
done

if [ -z "$PY312" ]; then
    echo "[install_callback] FAIL: 未找到 Python 3.12" >> "$LOGF"
    exit 1
fi

echo "[install_callback] PY312=$PY312" >> "$LOGF"

# 建目录
APP_DIR="$APPDEST/app"
if [ ! -f "$APP_DIR/proxy/requirements.txt" ] && [ -f "$APPDEST/proxy/requirements.txt" ]; then
    APP_DIR="$APPDEST"
fi
if [ ! -f "$APP_DIR/proxy/requirements.txt" ]; then
    echo "[install_callback] FAIL: 未找到 proxy/requirements.txt（APP_DIR=$APP_DIR）" >> "$LOGF"
    exit 1
fi

mkdir -p "$APP_DIR/cache" >> "$LOGF" 2>&1 || { echo "[install_callback] FAIL: mkdir cache" >> "$LOGF"; exit 1; }
mkdir -p "$APP_DIR/play_history" >> "$LOGF" 2>&1 || { echo "[install_callback] FAIL: mkdir play_history" >> "$LOGF"; exit 1; }
mkdir -p "$APP_DIR/log" >> "$LOGF" 2>&1 || { echo "[install_callback] FAIL: mkdir log" >> "$LOGF"; exit 1; }

# ===== 持久化目录 =====
# 上面那几个 mkdir 是给老版本 / 非飞牛环境的兜底，真正的可变状态不放安装目录：
# 安装目录（target）覆盖安装时会被整体替换，.env 里存着酷狗登录凭证，
# 放那儿等于"每次升级掉一次登录"。飞牛给了持久目录：
#   etc → /vol1/@appconf/<app>   （配置：.env）
#   var → /vol1/@appdata/<app>   （运行数据：缓存）
#   home→ /vol1/@apphome/<app>   （用户数据：在线收藏）
# 推导走 /var/apps/<app>/<sub> 这个飞牛建的符号链接，不要用 $APPDEST/../etc
# —— APPDEST 是 /vol1/@appcenter/<app> 的真实路径，它的 ../etc 不存在。
PKG_APP_NAME="fnmusic_kugou_pro"
PKG_META_DIR="/var/apps/${PKG_APP_NAME}"
pick_pkg_dir() {
    local _var="$1" _link="$2" _fallback="$3" _v
    _v="${!_var:-}"
    if [ -n "$_v" ]; then
        # TRIM_* 是"调用方应用"的上下文。串了的话不能认，否则 .env
        # （含酷狗登录 token）会落到别的应用配置目录去。按"整段路径"匹配，
        # 因为注入值可能是 @appconf/<app>（末段是应用名），也可能是
        # /var/apps/<app>/etc（应用名在中间）。
        case "/$_v/" in
            */"$PKG_APP_NAME"/*) printf '%s' "$_v"; return ;;
            *) echo "[install_callback] 忽略 ${_var}=${_v}（不属于 ${PKG_APP_NAME}）" >> "$LOGF" ;;
        esac
    fi
    [ -d "$_link" ] && { printf '%s' "$_link"; return; }
    printf '%s' "$_fallback"
}
ETC_DIR="$(pick_pkg_dir TRIM_PKGETC "${PKG_META_DIR}/etc" "${APPDEST}/etc")"
VAR_DIR="$(pick_pkg_dir TRIM_PKGVAR "${PKG_META_DIR}/var" "${APPDEST}/var")"
PKG_HOME_DIR="$(pick_pkg_dir TRIM_PKGHOME "${PKG_META_DIR}/home" "${APPDEST}/home")"
mkdir -p "$ETC_DIR" "$VAR_DIR" "$PKG_HOME_DIR/online_favorites" >> "$LOGF" 2>&1 \
    || { echo "[install_callback] FAIL: mkdir 持久目录" >> "$LOGF"; exit 1; }
chmod 700 "$ETC_DIR" 2>/dev/null || true
echo "[install_callback] 持久目录 ETC=$ETC_DIR VAR=$VAR_DIR HOME=$PKG_HOME_DIR" >> "$LOGF"
echo "[install_callback] 目录建好" >> "$LOGF"

# venv
VENV="$APP_DIR/.venv-proxy"
if [ ! -x "$VENV/bin/pip" ]; then
    echo "[install_callback] 创建 venv..." >> "$LOGF"
    "$PY312" -m venv "$VENV" >> "$LOGF" 2>&1 || { echo "[install_callback] FAIL: venv" >> "$LOGF"; exit 1; }
    echo "[install_callback] venv 创建成功" >> "$LOGF"
else
    echo "[install_callback] venv 已存在" >> "$LOGF"
fi

VENV_PIP="$VENV/bin/pip"
VENV_PY="$VENV/bin/python3"
echo "[install_callback] VENV_PIP=$VENV_PIP" >> "$LOGF"

# 装依赖
if [ ! -x "$VENV/bin/uvicorn" ]; then
    REQ="$APP_DIR/proxy/requirements.txt"
    echo "[install_callback] 装依赖 (REQ=$REQ)" >> "$LOGF"

    # 跳过 pip upgrade，venv 自带 pip 已够新
    # 用 timeout 避免网络卡住
    if timeout 300 "$VENV_PIP" install -i "https://pypi.tuna.tsinghua.edu.cn/simple" -r "$REQ" >> "$LOGF" 2>&1; then
        echo "[install_callback] 依赖安装成功 (清华)" >> "$LOGF"
    elif timeout 300 "$VENV_PIP" install -i "https://mirrors.aliyun.com/pypi/simple" -r "$REQ" >> "$LOGF" 2>&1; then
        echo "[install_callback] 依赖安装成功 (阿里)" >> "$LOGF"
    elif timeout 300 "$VENV_PIP" install -r "$REQ" >> "$LOGF" 2>&1; then
        echo "[install_callback] 依赖安装成功 (官方)" >> "$LOGF"
    else
        echo "[install_callback] FAIL: 依赖安装全部失败" >> "$LOGF"
        exit 1
    fi
else
    echo "[install_callback] 依赖已安装" >> "$LOGF"
fi

# 语法检查
"$VENV_PY" -m py_compile "$APP_DIR/proxy/app.py" "$APP_DIR/proxy/kugou_source.py" >> "$LOGF" 2>&1 || echo "[install_callback] WARN: 语法告警" >> "$LOGF"

# 生成 .env
#
# 三个容易踩的坑（前两条是修出来的，第三条是修第二条时修出来的）：
# 1) 向导（wizard/install|config）里用户填的 FNMUSIC_* 是以**同名环境变量**
#    传进来的 —— 这是向导值唯一的传递通道。0.x 的原实现把 URL/音质写死成
#    默认值，用户填的地址安装完就被覆盖回 127.0.0.1:8899，等于向导白填。
# 2) 重装/覆盖安装时不能把用户已经存好的 token、落盘目录清空。已经存在的
#    .env 先读进来当底值。
# 3) ★ 但"环境变量无条件优先"会带来反向事故（P-05，1.0.2 修）：
#    覆盖安装时向导会带着 initValue（见 wiz_default 里的地址/音质）一起提交，
#    用户多半直接点"下一步"，于是这两个默认值把用户自己配好的地址与音质冲掉。
#    服务照跑、healthz 照报 ok，表现是"搜不到歌"而不是"装坏了"，极难定位。
#    （这里**不写具体端口**：cmd/ 会打进分发包，那是本机部署事实，不是产品事实。）
#    ⇒ 现在的规则（见 env_scalar）：用 initValue 当"用户没动过"的指纹。
#         .env 不存在               → 向导值 > 默认值
#         .env 存在 & 向导值==initValue → 保留 .env 旧值
#         .env 存在 & 向导值!=initValue → 采用向导值（用户主动改过）
#    想改配置请优先用扩展设置页（POST /_ext/settings，即时生效、不用重装）。
ENV_FILE="$ETC_DIR/.env"
# 1.0.0 分叉起：**不再有任何"从安装目录迁移 .env"的逻辑**。
# 依据：本分支以 fnmusic_ext_kugou 2.1.0 为基线，2.1.0 的 .env 本来
# 就在配置目录，不存在"安装目录里的旧 .env"这种历史包袱（那是 2.1.1~2.1.2
# 自迭代期间的问题，无迁移义务）。留着只会让人误以为还有旧数据要救。

# 值清洗：换行/回车/NUL/其它控制字符会破坏 .env 行结构（run_proxy.sh 逐行
# 解析，且 .env 由网页端可写），一律剔除。
env_clean() {
    printf '%s' "$1" | tr -d '\000-\037\177'
}

# 读已有 .env 里某个 key 的现值（没有则空）。注意必须在重定向截断 .env
# **之前**调用，否则读到的是刚被 truncate 的空文件。
# 覆盖安装时用户的登录凭证/落盘设置就在 ENV_FILE 里，必须先读出来当底值，
# 否则重装一次就"读不到 → 写成空 → 登录态丢失"。
env_current() {
    local _f
    for _f in "$ENV_FILE"; do
        if [ -f "$_f" ]; then
            local _v
            _v="$(grep -m1 "^$1=" "$_f" 2>/dev/null | sed "s/^$1=//")"
            [ -n "$_v" ] && { printf '%s' "$_v"; return 0; }
        fi
    done
    return 0
}

# 读已有 .env 里某个 key 的原始值，**区分"键不存在"与"键存在但值为空"**。
# 返回 0 = 键存在（输出可能是空串）；返回 1 = 键不存在 / 没有 .env。
# 与上面的 env_current 的区别：env_current 是"有值才用"（凭证类语义），
# 这里是"键在不在"（配置类语义）。两者不能混用 —— 布尔开关的 0 和空不是一回事。
env_raw() {
    local _key="$1" _line
    [ -f "$ENV_FILE" ] || return 1
    _line="$(grep -m1 "^${_key}=" "$ENV_FILE" 2>/dev/null)"
    [ -n "$_line" ] || return 1
    printf '%s' "${_line#*=}"
    return 0
}

# 向导字段的 initValue —— 必须与 wizard/install、wizard/config、
# wizard/ui/index.html 里的同名 field 一致。
# tests/test_install_env_priority.py 会断言四处一致：默认值漂移是真实发生过的事故
# （向导写 128、后端默认写 high，两处各自硬编码，谁也不知道对方变了）。
wiz_default() {
    case "$1" in
        FNMUSIC_KUGOU_URL)            printf '%s' "http://127.0.0.1:8899" ;;
        FNMUSIC_KUGOU_QUALITY)        printf '%s' "high" ;;
        FNMUSIC_KUGOU_SEARCH_TIMEOUT) printf '%s' "15" ;;
        FNMUSIC_KUGOU_ENABLED)        printf '%s' "1" ;;
        *)                            printf '%s' "" ;;
    esac
}

# 取值内核。$3 = scalar | flag
#
#   scalar（地址 / 目录 / 超时 / 枚举）：空值对它们没有意义，视为"未设置"。
#   flag  （开关）：0 / false 是**有效表态**，不能被默认值盖掉。
#
# 两者只在"键存在但值为空"时有区别：flag 会多打一条 WARN，提醒这个空值是
# 异常状态（历史上出现过"写入空行 → 读取侧回落默认 → 用户关掉的开关自己开回来"）。
_env_take() {
    local _key="$1" _default="$2" _kind="$3"
    local _cur="" _has=0 _wiz _def _val

    _wiz="${!_key:-}"                  # 向导传进来的值；空 = 向导没传这个字段
    _def="$(wiz_default "$_key")"      # 向导的 initValue

    if _cur="$(env_raw "$_key")"; then
        _has=1
    fi

    if [ "$_has" = "1" ]; then
        # —— .env 里已经有这个键 ——
        #
        # ① 逃生口：显式要求采用向导值。默认关闭，正常升级/重装走不到这里。
        #    用途：确实想用应用中心「配置」页改 URL/音质的人。
        #      sudo FNMUSIC_ADOPT_WIZARD=1 appcenter-cli install-fpk xxx.fpk
        #    ⚠ 必须先判 $_wiz 非空 —— 否则"开了逃生口但向导没传这个字段"会把
        #      用户配置写成一串空值（比覆盖更糟）。
        if [ "${FNMUSIC_ADOPT_WIZARD:-0}" = "1" ] && [ -n "$_wiz" ]; then
            note "ADOPT ${_key}: 已显式要求采用向导值(${_wiz})，覆盖原值(${_cur})"
            printf '%s' "$(env_clean "$_wiz")"
            return 0
        fi
        # ② 向导没传这个字段 ⇒ 保留现值
        if [ -z "$_wiz" ]; then
            if [ -z "$_cur" ] && [ "$_kind" = "flag" ]; then
                note "WARN ${_key} 在 .env 中存在但值为空，按原样保留（不回落到默认 ${_default}）"
            fi
            printf '%s' "$(env_clean "$_cur")"
            return 0
        fi
        # ③ 其余情况：一律保留现有值。
        #
        # ⚠ 不能用「向导值 != initValue ⇒ 用户主动改过」来判定。飞牛在升级/重装时
        # 会把**上次提交的表单值**原样回放给 install_callback；老用户的值与新包的
        # initValue 天然不相等，会被误判成"用户在向导里改了"，从而静默覆盖用户配置。
        # （1.0.2 真机升级实测：QUALITY 从 high 被回放成 128，音质静默降级。）
        #
        # 判错的两种代价不对称：
        #   · "设置页改过"被误当成"向导改过" → 用户设置被静默回滚（不可接受）
        #   · "配置页改过"被忽略 → 用户当场看到下面这条提示，且设置页仍能改
        # 故一律选"保留"，并给一个显式逃生口（见 ①）。
        #
        # 只在「向导值既不同于现值、也不同于本版默认值」时才提示 —— 那是**唯一**
        # 能说明"用户可能真的在配置页动过"的情形；回放默认值时提示纯属噪音，
        # 每次升级都刷一遍反而让真正的信号被忽略。
        if [ "$_wiz" != "$_cur" ] && [ "$_wiz" != "$_def" ]; then
            note "KEEP ${_key}: 已有配置优先，忽略向导值(${_wiz})（本版默认 ${_def}），保留(${_cur})；如需修改请用扩展设置页（或用 FNMUSIC_ADOPT_WIZARD=1 重装以强制采用向导值）"
        fi
        printf '%s' "$(env_clean "$_cur")"
        return 0
    fi

    # —— .env 里没有这个键（首次安装，或本次新增的配置项）——
    _val="$_wiz"
    [ -n "$_val" ] || _val="$_default"
    printf '%s' "$(env_clean "$_val")"
}

env_scalar() { _env_take "$1" "$2" scalar; }
env_flag()   { _env_take "$1" "$2" flag; }

# 写盘前备份 .env：配置事故要能一键回滚。只保留最近 3 份。
backup_env() {
    [ -f "$ENV_FILE" ] || return 0
    local _bak _old
    _bak="${ENV_FILE}.bak.$(date +%Y%m%d-%H%M%S)"
    if cp -p "$ENV_FILE" "$_bak" 2>/dev/null; then
        chmod 600 "$_bak" 2>/dev/null || true
        echo "[install_callback] .env 已备份 -> $_bak" >> "$LOGF"
    else
        echo "[install_callback] WARN: .env 备份失败（继续安装）" >> "$LOGF"
        return 0
    fi
    ls -1t "${ENV_FILE}".bak.* 2>/dev/null | tail -n +4 | while IFS= read -r _old; do
        rm -f "$_old" 2>/dev/null || true
    done
}

KUGOU_ENABLED="$(env_flag   FNMUSIC_KUGOU_ENABLED 1)"
KUGOU_URL="$(env_scalar FNMUSIC_KUGOU_URL "http://127.0.0.1:8899")"
KUGOU_QUALITY="$(env_scalar FNMUSIC_KUGOU_QUALITY "high")"
KUGOU_TIMEOUT="$(env_scalar FNMUSIC_KUGOU_SEARCH_TIMEOUT 15)"
LIBRARY_DIR="$(env_scalar FNMUSIC_LIBRARY_DIR "")"
SAVE_ENABLED="$(env_flag   FNMUSIC_SAVE_ENABLED 0)"
SAVE_DIR="$(env_scalar FNMUSIC_SAVE_DIR "")"
SAVE_TAGS="$(env_flag   FNMUSIC_SAVE_WRITE_TAGS 1)"
SAVE_COVER="$(env_flag   FNMUSIC_SAVE_WRITE_COVER 1)"
SAVE_LYRIC="$(env_flag   FNMUSIC_SAVE_WRITE_LYRIC 1)"
# 本地优先播放（1.0.2 / F-02）：已归档过的歌直接读本地文件，不再向酷狗换 CDN。
# 默认开。写成 .env 里的一行是为了让用户能一眼看到、也能手工关掉排查问题；
# 关掉的等价写法是 FNMUSIC_LOCAL_FIRST=0（重启生效）。
LOCAL_FIRST="$(env_flag FNMUSIC_LOCAL_FIRST 1)"
# 去重索引目录：默认留空，由 app.py 推导到落盘目录下的隐藏子目录
# （跟着曲库走，覆盖安装/升级不会丢，也就不会把听过的歌再存一遍）。
SAVE_MARKER="$(env_scalar FNMUSIC_SAVE_MARKER_DIR "")"
# 这几个曾在 .env 里出现但没人回读，一并补齐（值都非凭证，可安全保留旧值）。
# 注意 FNMUSIC_KUGOU_SEARCH_TIMEOUT 已在上面 KUGOU_TIMEOUT 处理，这里不要再
# echo 一遍 —— 重复键会让 .env 出现两行同名条目，读回时以后者为准，
# 排障时极易看错。
SAVE_MAX_BYTES="$(env_scalar FNMUSIC_SAVE_MAX_BYTES "")"
SAVE_TIMEOUT="$(env_scalar FNMUSIC_SAVE_TIMEOUT_S "")"
FAV_DIR="$(env_scalar FNMUSIC_FAV_DIR "")"
# 凭证类字段：只保留已有值（免得不小心把扫码登录存的 token 冲掉）。
# 同样必须在写文件之前先读出来。
TOKEN="$(env_clean "$(env_current FNMUSIC_KUGOU_TOKEN)")"
USERID="$(env_clean "$(env_current FNMUSIC_KUGOU_USERID)")"
DFID="$(env_clean "$(env_current FNMUSIC_KUGOU_DFID)")"
T1="$(env_clean "$(env_current FNMUSIC_KUGOU_T1)")"
MID="$(env_clean "$(env_current FNMUSIC_KUGOU_MID)")"
GUID="$(env_clean "$(env_current FNMUSIC_KUGOU_GUID)")"
DEV="$(env_clean "$(env_current FNMUSIC_KUGOU_DEV)")"
MACV="$(env_clean "$(env_current FNMUSIC_KUGOU_MAC)")"
echo "[install_callback] .env 解析: url=${KUGOU_URL} quality=${KUGOU_QUALITY} library=${LIBRARY_DIR}" >> "$LOGF"

# 写盘前先备份（.env.bak.<时间戳>，只留最近 3 份）。
# 必须在所有 env_* 读完、且在任何写操作之前调用。
backup_env

# 写到临时文件再原子替换：避免"重定向先截断"把上面读到的值吃掉。
ENV_TMP="${ENV_FILE}.tmp.$$"
{
    echo "FNMUSIC_KUGOU_ENABLED=${KUGOU_ENABLED}"
    echo "FNMUSIC_KUGOU_URL=${KUGOU_URL}"
    echo "FNMUSIC_KUGOU_QUALITY=${KUGOU_QUALITY}"
    echo "FNMUSIC_KUGOU_SEARCH_TIMEOUT=${KUGOU_TIMEOUT}"
    echo "FNMUSIC_KUGOU_TOKEN=${TOKEN}"
    echo "FNMUSIC_KUGOU_USERID=${USERID}"
    echo "FNMUSIC_KUGOU_DFID=${DFID}"
    echo "FNMUSIC_KUGOU_T1=${T1}"
    echo "FNMUSIC_KUGOU_MID=${MID}"
    echo "FNMUSIC_KUGOU_GUID=${GUID}"
    echo "FNMUSIC_KUGOU_DEV=${DEV}"
    echo "FNMUSIC_KUGOU_MAC=${MACV}"
    echo "FNMUSIC_LIBRARY_DIR=${LIBRARY_DIR}"
    echo "FNMUSIC_SAVE_ENABLED=${SAVE_ENABLED}"
    echo "FNMUSIC_SAVE_DIR=${SAVE_DIR}"
    echo "FNMUSIC_SAVE_WRITE_TAGS=${SAVE_TAGS}"
    echo "FNMUSIC_SAVE_WRITE_COVER=${SAVE_COVER}"
    echo "FNMUSIC_SAVE_WRITE_LYRIC=${SAVE_LYRIC}"
    echo "FNMUSIC_LOCAL_FIRST=${LOCAL_FIRST}"
    echo "FNMUSIC_SAVE_MARKER_DIR=${SAVE_MARKER}"
    echo "FNMUSIC_SAVE_MAX_BYTES=${SAVE_MAX_BYTES}"
    echo "FNMUSIC_SAVE_TIMEOUT_S=${SAVE_TIMEOUT}"
    echo "FNMUSIC_FAV_DIR=${FAV_DIR}"
} > "$ENV_TMP" || { echo "[install_callback] FAIL: 写 .env" >> "$LOGF"; rm -f "$ENV_TMP"; exit 1; }
# 曾为 666，而 .env 里存酷狗 token：同机任何用户/容器都能读走。改 600。
chmod 600 "$ENV_TMP" 2>/dev/null || true
mv -f "$ENV_TMP" "$ENV_FILE" 2>/dev/null || { echo "[install_callback] FAIL: 替换 .env" >> "$LOGF"; rm -f "$ENV_TMP"; exit 1; }
chmod 600 "$ENV_FILE" 2>/dev/null || true
echo "[install_callback] .env 写好 -> $ENV_FILE" >> "$LOGF"

# 1.0.0 分叉起不再清理"安装目录里的旧 .env"——那条路径已不存在。
# （原逻辑存在的意义是防"包内空模板下次升级又盖掉凭证"，而本分支的
