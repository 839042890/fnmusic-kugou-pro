#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026 ai2ku (https://github.com/ai2ku/)
# Copyright (C) 2026 星痕在此 (fnmusic_kugou_pro fork, 独立维护)
# fnmusic-pro cmd/main
# 进程管理 + 停止时还原 socket

# ===== 共享状态工具 =====
# 状态目录 / 判活 / 按 cmdline 找回与清理进程，四个入口（main、stop_callback、
# uninstall_init、uninstall_callback）共用同一份实现。理由见该文件头注释。
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if ! . "${SCRIPT_DIR}/_proxy_state.sh"; then
    echo "缺少 ${SCRIPT_DIR}/_proxy_state.sh（包不完整？）" >&2
    exit 1
fi

# ===== 状态文件：一律放持久目录 =====
# 1.0.0 把它们放在 /tmp。两个真实后果（P-01）：
#   ① /tmp 被清理（重启、或任何清理脚本删 fnmusic*）之后，应用中心读不到
#      PID → 判「已关闭」，而进程其实还在服务（状态显示与实际不符）；
#   ② 此时 stop 也读不到 PID → 杀不掉旧进程 → 它变成孤儿，与新实例
#      同时挂同一个 socket，白占内存。
# 现在落 TRIM_PKGVAR（@appdata），并保留 /tmp 的**只读**兼容（升级后第一次
# 启动还能读到旧记录）。写新文件时显式 chmod：本平台新建文件权限 = 父目录
# 权限，umask 不参与。
STATE_DIR="$(fnmusic_state_dir)"
mkdir -p "$STATE_DIR" 2>/dev/null || STATE_DIR="/tmp"
LOG="${STATE_DIR}/${FNMUSIC_STATE_LOG_NAME}"
PID_FILE="${STATE_DIR}/${FNMUSIC_STATE_PID_NAME}"
RUN_LOG="${STATE_DIR}/${FNMUSIC_STATE_RUNLOG_NAME}"
APPDEST_FILE="${STATE_DIR}/${FNMUSIC_STATE_APPDEST_NAME}"
# 1.0.0 及更早的位置（只读兼容，不再写）
LEGACY_PID_FILE="/tmp/${FNMUSIC_STATE_PID_NAME}"
LEGACY_APPDEST_FILE="/tmp/${FNMUSIC_STATE_APPDEST_NAME}"

log() { echo "[$(date '+%H:%M:%S')] $*" >> "$LOG"; }

ACTION="${1:-}"
[ -n "$ACTION" ] || { log "usage: $0 {start|stop|status}"; exit 1; }

APPDEST="${TRIM_APPDEST:-}"
if [ -z "$APPDEST" ] && [ -f "$APPDEST_FILE" ]; then
    APPDEST="$(cat "$APPDEST_FILE" 2>/dev/null)"
fi
if [ -z "$APPDEST" ] && [ -f "$LEGACY_APPDEST_FILE" ]; then
    APPDEST="$(cat "$LEGACY_APPDEST_FILE" 2>/dev/null)"
    log "APPDEST 取自旧位置 ${LEGACY_APPDEST_FILE}"
fi
[ -n "$APPDEST" ] || { log "APPDEST 未注入"; exit 1; }

# 把安装目录记到持久状态目录：stop_callback / uninstall_init 未必拿得到
# TRIM_APPDEST，而"按 cmdline 认领进程"必须先知道安装目录。
# （1.0.0 定义了 APPDEST_FILE 却从来没写过 —— 这行就是补那个洞。）
if [ "$(cat "$APPDEST_FILE" 2>/dev/null || true)" != "$APPDEST" ]; then
    if printf '%s\n' "$APPDEST" > "$APPDEST_FILE" 2>/dev/null; then
        chmod 600 "$APPDEST_FILE" 2>/dev/null || true
    fi
fi

# 安装目录解析走共享实现（与 stop_callback / uninstall_init 同一份逻辑，
# 免得"main 认得的路径"和"stop_callback 认得的路径"哪天不一致）
if ! APP_DIR="$(fnmusic_app_dir "$STATE_DIR")"; then
    log "未找到 run_proxy.sh（APPDEST=$APPDEST）"
    exit 1
fi
# 归一成真实路径再拿去比对 /proc 的 cmdline（APP_DIR 可能是 /var/apps/<app>/target
# 这类符号链接，而进程里记的是 /vol1/@appcenter/<app>）。
APP_DIR_REAL="$(readlink -f "$APP_DIR" 2>/dev/null || printf '%s' "$APP_DIR")"

APP_SOCK="$APP_DIR/fnmusic_kugou_pro.sock"

# ===== 把飞牛的持久化目录确定下来并传给子进程 =====
# run_proxy.sh 里也有一份同样的推导（它可能被单独调用），这里先把值定好，
# 免得依赖"环境变量一定被注入"。注意用 /var/apps/<app>/etc 而非 $APPDEST/../etc：
# APPDEST 是 /vol1/@appcenter/<app> 的真实路径，它的 ../etc 不存在。
PKG_APP_NAME="fnmusic_kugou_pro"
PKG_META_DIR="/var/apps/${PKG_APP_NAME}"
resolve_pkg_dir() {
    local _var="$1" _link="$2" _fallback="$3" _v
    _v="${!_var:-}"
    if [ -n "$_v" ]; then
        # TRIM_* 属于"调用方应用"。串了的话不能认，否则 .env（含 token）
        # 会落到别的应用目录里去。按"整段路径"匹配：注入值可能是
        # /vol1/@appconf/<app>（末段是应用名），也可能是 /var/apps/<app>/etc
        # （应用名在中间），只比末段会误拒后者。
        case "/$_v/" in
            */"$PKG_APP_NAME"/*) printf '%s' "$_v"; return ;;
            *) log "忽略 ${_var}=${_v}（不属于 ${PKG_APP_NAME}）" ;;
        esac
    fi
    [ -d "$_link" ] && { printf '%s' "$_link"; return; }
    printf '%s' "$_fallback"
}
# 兜底只在"既没注入变量、也没有 /var/apps 链接"时走到（即非飞牛环境）。
# 故意退回到安装目录内，而不是 $APPDEST/../etc（那是 /vol1/@appcenter/etc，
# 会在应用目录之外造出垃圾目录）。
export TRIM_PKGETC="$(resolve_pkg_dir TRIM_PKGETC "${PKG_META_DIR}/etc" "${APPDEST}/etc")"
export TRIM_PKGVAR="$(resolve_pkg_dir TRIM_PKGVAR "${PKG_META_DIR}/var" "${APPDEST}/var")"
export TRIM_PKGHOME="$(resolve_pkg_dir TRIM_PKGHOME "${PKG_META_DIR}/home" "${APPDEST}/home")"
mkdir -p "$TRIM_PKGETC" "$TRIM_PKGVAR" "$TRIM_PKGHOME" 2>/dev/null || true

is_running() {
    # 三级兜底（实现在 _proxy_state.sh）：
    #   ① PID 文件 —— 带 /proc cmdline 校验，防"PID 被复用"时误报（并防止
    #      stop 时把无关进程杀掉）；
    #   ② /proc 扫盘 —— PID 文件被清掉也能把进程找回来，并回写 PID 文件；
    #   ③ healthz 指纹 —— 连进程都扫不到时的最后一道（要求响应里带本应用名）。
    if fnmusic_is_running "$APP_DIR_REAL" "$PID_FILE"; then
        if [ "${FNMUSIC_LAST_SOURCE:-pidfile}" != "pidfile" ]; then
            log "判活命中兜底（来源=${FNMUSIC_LAST_SOURCE} PID=${FNMUSIC_LAST_PID:-?}）：" \
                "PID 文件缺失或失效，已回写 $PID_FILE"
        fi
        return 0
    fi
    return 1
}

# 检查 socket 类型：unix socket / regular file / 不存在
sock_is_unix() {
    [ -e "$1" ] && stat -c '%F' "$1" 2>/dev/null | grep -qi '^socket'
}

# 检查 TARGET 上的服务是不是代理（通过 healthz 判断）
is_proxy_at_target() {
    local h
    h="$(curl -s --max-time 2 --unix-socket /var/run/trim_music.socket http://localhost/_ext/healthz 2>/dev/null || true)"
    echo "$h" | grep -q '"upstream"'
}

# ===== 音乐接口占用检测（1.0.0 新增）=====
# 为什么需要：本应用与上游 fnmusic_ext_kugou 用的是同一套 socket 接管架构，
# 而两者的 uninstall 脚本都会"看到 TARGET 是代理就删掉它、再把真音乐搬回来"。
# 于是两版若同时存在，卸载其中任意一个都会把另一个静默拆掉（用户以为坏了）。
# 旧版代码我们改不了，唯一可行的防御是：**让两版永不共存运行**。
#
# 判据：不看目录是否存在（目录残留极常见，@appconf 里就有 22 个已卸载
# 应用的残留目录；用它判据会导致"自锁，永远装不上"），而是直接看
# **谁真正握着 /var/run/trim_music.socket 这把锁**。
#
# 返回 0 = 音乐 socket 被"本应用以外的扩展"占着（冲突）
foreign_proxy_owns_target() {
    local TARGET="/var/run/trim_music.socket"

    [ -S "$TARGET" ] || return 1          # 无 socket -> 无冲突
    is_proxy_at_target || return 1        # 是飞牛音乐本体 -> 无冲突

    # TARGET 上确实是个代理。那是不是"我自己"在跑？自己不算冲突。
    # 两道判据：① PID 文件里的进程还活着；② 我自己的网关 socket 还在。
    # 为什么加 ②：/tmp 会在重启时被清空，PID 文件随之消失。若只认 ①，
    # 重启后本应用可能把自己的残留 socket 判成"别人占着"，从而**自锁起不来**
    # —— 那正是我们想避免的失败模式。
    if is_running; then
        return 1
    fi
    if [ -S "$APP_SOCK" ]; then
        return 1                          # 我自己的网关 socket 在 -> 是残留，不是别人
    fi
    return 0                               # 是代理，但不是我在跑 -> 别人占着
}

# 仅用于日志/提示：报出占用者是谁（不作为判据，拿不到也不影响判断）
identify_owner() {
    local TARGET="/var/run/trim_music.socket" pid cmd
    pid="$(ss -xlp 2>/dev/null | grep -F "$TARGET" \
           | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2)"
    if [ -n "$pid" ] && [ -r "/proc/$pid/cmdline" ]; then
        cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
    fi
    printf 'pid=%s cmd=%s' "${pid:-?}" "${cmd:-?}"
}

restore_socket() {
    local TARGET="/var/run/trim_music.socket"
    local UPSTREAM="/var/run/trim_music_upstream.socket"

    log "还原 socket: $UPSTREAM -> $TARGET"

    # 若 TARGET 上是代理 socket，删掉
    if [ -e "$TARGET" ]; then
        if is_proxy_at_target; then
            rm -f "$TARGET" 2>/dev/null || true
            log "删除代理 socket"
        else
            log "⚠️ TARGET 上是飞牛音乐，不删除"
        fi
    fi

    # 若 upstream 是 unix socket，mv 回 TARGET
    if sock_is_unix "$UPSTREAM"; then
        rm -f "$TARGET" 2>/dev/null || true
        mv "$UPSTREAM" "$TARGET" 2>/dev/null || true
        chmod 666 "$TARGET" 2>/dev/null || true
        log "socket 已还原"
    else
        log "⚠️ upstream socket 不存在，无法还原（飞牛【音乐】需手动重启）"
    fi
}

log "==== $ACTION (whoami=$(id -un)) APPDEST=$APPDEST ===="

case "$ACTION" in
    start)
        if is_running; then
            log "已在运行 (PID=${FNMUSIC_LAST_PID:-$(fnmusic_pid_file_read "$PID_FILE" || echo '?')})"
            exit 0
        fi
        rm -f "$PID_FILE" 2>/dev/null || true

        # ★ 1.0.0 新增：先验"音乐接口是否被别的扩展占着"。
        # 必须放在下面"清理残留代理 socket"之前 —— 否则我们会把**别人**的
        # 代理 socket 当成"自己的残留"删掉，等于主动抢占，冲突更严重。
        # 占用检测失败时：一个字节都不动音乐端，直接拒绝启动。
        if foreign_proxy_owns_target; then
            log "拒绝启动：/var/run/trim_music.socket 已被另一个音源扩展占用"
            log "占用者：$(identify_owner)"
            log "请先到【应用中心】停用并卸载旧扩展 fnmusic_ext_kugou，再启动本应用。"
            log "（本应用未接管任何 socket，飞牛【音乐】未受影响。）"
            exit 1
        fi

        # 关键：确保代理没有残留 socket 占用 TARGET
        if is_proxy_at_target; then
            rm -f /var/run/trim_music.socket 2>/dev/null || true
            log "清理残留代理 socket"
            sleep 1
        fi

        cd "$APP_DIR" || { log "cd 失败"; exit 1; }
        rm -f "$APP_SOCK" 2>/dev/null || true
        export TRIM_APPDEST="$APPDEST"
        export FNMUSIC_APP_SOCK="$APP_SOCK"
        export FNMUSIC_UPSTREAM_SOCK="/var/run/trim_music.socket"
        log "持久目录 ETC=$TRIM_PKGETC VAR=$TRIM_PKGVAR HOME=$TRIM_PKGHOME"

        nohup bash -c 'exec ./proxy/run_proxy.sh' >>"$RUN_LOG" 2>&1 &
        local_pid=$!
        echo "$local_pid" > "$PID_FILE"
        log "启动代理 PID=$local_pid"

        nohup bash -c 'exec /var/apps/python312/target/bin/python3 ./proxy/app_socket_bridge.py' >>"$RUN_LOG" 2>&1 &
        bridge_pid=$!
        log "启动网关桥接器 PID=$bridge_pid"

        sleep 5
        # 判活以 $local_pid 为准（与 1.0.0 一致）：run_proxy.sh 还在预检时
        # cmdline 仍是 ./proxy/run_proxy.sh，不能拿"扫不到 uvicorn"当死亡。
        if kill -0 "$local_pid" 2>/dev/null; then
            if fnmusic_pid_is_ours "$local_pid" "$APP_DIR_REAL"; then
                log "代理存活 PID=$local_pid（cmdline 已确认为本应用）"
            else
                log "代理存活 PID=$local_pid（cmdline 暂未确认，可能仍在预检）"
            fi
        else
            log "代理进程死亡。run.log 尾部："
            tail -30 "$RUN_LOG" 2>&1 >> "$LOG" || true
            kill "$bridge_pid" 2>/dev/null || true
            rm -f "$APP_SOCK" 2>/dev/null || true
            # 关键：代理没起来，但 TARGET 上的音乐 socket 可能已被 run_proxy.sh
            # 改名成 UPSTREAM。此时若不还原，【音乐】会一直不可用（2.1.3 事故）。
            # 启动失败要"失败得干净"：把音乐端还回去。
            log "启动失败，尝试还原音乐端 socket..."
            restore_socket
            exit 1
        fi
        # 网关 socket 通常晚几秒才出现（run_proxy 要先等到 trim-music 就绪）。
        # 1.0.0 只看一眼就判失败，等于把"还在等上游"当成"没起来"。
        for _i in $(seq 1 10); do
            sock_is_unix "$APP_SOCK" && break
            sleep 1
        done
        if sock_is_unix "$APP_SOCK"; then
            log "网关 socket 存活: $APP_SOCK"
            exit 0
        fi
        log "网关 socket 未出现: $APP_SOCK；run.log 尾部："
        tail -30 "$RUN_LOG" 2>&1 >> "$LOG" || true
        exit 1
        ;;
    stop)
        # 杀干净：PID 文件 + /proc 扫盘 + 网关桥接器。
        # 只靠 PID 文件的老做法在"PID 文件被清掉"时什么都杀不到，旧进程会
        # 变成孤儿并与新实例抢同一个 socket —— 这正是 P-01 的第 2 条影响。
        _scanned="$(fnmusic_find_pids "$APP_DIR_REAL" | tr '\n' ' ')"
        log "stop 前：PID 文件=$(fnmusic_pid_file_read "$PID_FILE" || echo 空)" \
            "扫盘到=[${_scanned% }]"
        fnmusic_kill_all "$APP_DIR_REAL" "$PID_FILE" "$LEGACY_PID_FILE"
        log "已停止代理进程（含兜底清理）"
        rm -f "$APP_SOCK" 2>/dev/null || true
        restore_socket
        exit 0
        ;;
    status)
        # 只写"兜底命中"这一类日志（见 is_running），正常轮询不产生噪音。
        if is_running; then
            exit 0
        fi
        exit 3
        ;;
    status)
        if is_running; then
            exit 0
        fi
        exit 3
        ;;
    *)
        log "未知动作: $ACTION"
        exit 1
        ;;
esac
